MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2113338832}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 638d7c0d2e1ed094898e6f5146903afc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizManager
  QnA:
  - Question: Wat vertelt de discriminant je over een kwadratische vergelijking?
    Answers:
    - "Het aantal re\xEBle oplossingen"
    - De maximale waarde
    - De helling van de grafiek
    CorrectAnswer: 1
  - Question: "Wat is het belangrijkste kenmerk van een exponenti\xEBle functie?"
    Answers:
    - Het heeft een constant verschil
    - Het heeft een constante verhouding
    - Het heeft altijd een maximum
    CorrectAnswer: 2
  - Question: Wat geeft een correlatie van -1 aan?
    Answers:
    - Geen relatie
    - Een perfecte positieve relatie
    - Een perfecte negatieve relatie
    CorrectAnswer: 3
  - Question: Wat vertelt de standaardafwijking je?
    Answers:
    - Hoe verspreid de gegevens zijn
    - De meest voorkomende waarde
    - De middelste waarde
    CorrectAnswer: 1
  - Question: Wat beschrijft de tweede wet van Newton?
    Answers:
    - De behoudswet van energie
    - De relatie tussen kracht, massa en versnelling
    - De relatie tussen spanning en weerstand
    CorrectAnswer: 2
  - Question: Wat gebeurt er met de weerstand van de meeste metalen wanneer hun temperatuur stijgt?
    Answers:
    - Het daalt
    - Het blijft constant
    - Het stijgt
    CorrectAnswer: 3
  - Question: "Welke grootheid blijft behouden in een ge\xEFsoleerd systeem?"
    Answers:
    - Energie
    - Versnelling
    - Snelheid
    CorrectAnswer: 1
  - Question: Wat betekent een hogere frequentie voor een golf?
    Answers:
    - Een langere golflengt in elke situatie
    - Meer trillingen per seconde
    - Eenhogere amplitude
    CorrectAnswer: 2
  - Question: Wat bepaalt de kinetische energie van een object?
    Answers:
    - Alleen de hoogte
    - De temperatuur en massa
    - De massa en snelheid
    CorrectAnswer: 3
  - Question: Waarom werkt een transformator alleen met wisselspanning?
    Answers:
    - Het heeft een veranderend magnetische veld nodig
    - Wisselspanning heeft geen weerstand
    - Gelijkspanning kan geen spanning opwekken
    CorrectAnswer: 1
  - Question: Wat doet een katalysator in een chemische reactie?
    Answers:
    - Verhoogt de hoeveelheid producten
    - Verlaagt de activeringsenergie
    - Verhoogt de evenwichtsconstante
    CorrectAnswer: 2
  - Question: Wat gebeurt er met het evenwicht van een exotherme reactie als de temperatuur wordt verhoogd?
    Answers:
    - Het verschuift naar de reactieproducten
    - Er gebeurt niets
    - Het verschuift naar de beginstoffen
    CorrectAnswer: 3
  - Question: Wat is oxidatie?
    Answers:
    - Elektronen verliezen
    - Elektronen opnemen
    - Protonen opnemen
    CorrectAnswer: 1
  - Question: Welk tupe binding omvat dat atomen elektronen delen?
    Answers:
    - Ionbinding
    - Covalente binding
    - Metaalbinding
    CorrectAnswer: 2
  - Question: Waarom verhoogt het verhogen van de concentratie van een beginstof meestal de reactiesnelheid?
    Answers:
    - De activatie-energie verdwijnt
    - De reactie wordt exotherm
    - Er zijn meer succesvolle botsingen
    CorrectAnswer: 3
  - Question: Wat meet de pH-schaal?
    Answers:
    - De concentratie van waterstofionen
    - De hoeveelheid opgelost zuurstof
    - De concentratie van elektronen
    CorrectAnswer: 1
  - Question: Wat is de belangrijkste functie van mRNA?
    Answers:
    - Produceert ATP
    - Draagt genetische informatie van DNA naar het ribosoom
    - Breekt eiwitten af
    CorrectAnswer: 2
  - Question: Wat is het verschil tussen mitose en meiose?
    Answers:
    - Mitose komt alleen voor bij planten
    - "Meiose produceert twee identieke diplo\xEFde cellen"
    - Mitose produceert genetisch identieke cellen; meiose produceert genetisch gevarieerde gameten
    CorrectAnswer: 3
  - Question: Wat is de rol van antilichamen in het immuunsysteem?
    Answers:
    - Ze herkennen specifieke antigenen
    - Ze produceren rechtstreeks rode bloedcellen
    - "Ze verteren bacteri\xEBn in de maag"
    CorrectAnswer: 1
  - Question: Waarom zijn enzymen specifiek voor bepaalde substraten?
    Answers:
    - "Ze werken alleen bij precies 37 \xB0C"
    - Hun actieve plek heeft een specifieke vorm
    - Ze bevatten DNA
    CorrectAnswer: 2
  - Question: Wat is een voordeel van seksuele voortplanting?
    Answers:
    - Het produceert genetisch identieke nakomelingen
    - "Het vereist slechts \xE9\xE9n ouder"
    - Het vergroot de genetische variatie
    CorrectAnswer: 3
  - Question: Wat betekent homeostase?
    Answers:
    - Het handhaven van een relatief stabiele interne omgeving
    - Het continu verhogen van lichaamstemperatuur
    - "Genetisch aanpassen binnen \xE9\xE9n levensduur"
    CorrectAnswer: 1
  - Question: Wat is de belangrijkste oorzaak van de seizoenen?
    Answers:
    - De veranderende afstand van de Aarde tot de Zon
    - De helling van de aardas
    - Veranderingen in de temperatuur van de Zon
    CorrectAnswer: 2
  - Question: Wat wordt bedoeld met globalisering?
    Answers:
    - Het verdwijnen van alle nationale grenzen
    - Het proces waarbij landen geografisch groter worden
    - Toenemende verbindingen en onderlinge afhanklijkheid tussen landen
    CorrectAnswer: 3
  - Question: Waarom liggen veel grote steden bij rivieren of kusten?
    Answers:
    - "Rivieren en zee\xEBn bieden transport en toegang tot handel"
    - Het klimaat is daar altijd warmer
    - Bergen kunnen daar niet ontstaan
    CorrectAnswer: 1
  - Question: Wat is een push-factor bij migratie?
    Answers:
    - Een reden die iemand aantrekt naar een ander gebied
    - Een reden die iemand wegdrijft van zijn huidige gebied
    - Een overheidsbeloning om te blijven
    CorrectAnswer: 2
  - Question: Wat is het broeikaseffect?
    Answers:
    - De weerkaatsing van al hetzonlicht door wolken
    - Het gat in de ozonlaag
    - De absorptie en heruitzending van infrarode straling door atmosferische gassen
    CorrectAnswer: 3
  - Question: Wat was een belangrijk principe van de Verlichting?
    Answers:
    - Reden en kritische nadenken
    - Absolute monarchie
    - Afwijzing van wetenschappelijk onderzoek
    CorrectAnswer: 1
  - Question: "Wat was een belangrijke oorzaak van de industri\xEBle Revolutie?"
    Answers:
    - De achteruitgang van de internationale handel
    - De ontwikkeling van nieuwe machines en productiemethoden
    - Het verdwijnen van steden
    CorrectAnswer: 2
  - Question: Wat betekent imperialisme?
    Answers:
    - "De onafhankelijkheid van koloni\xEBn"
    - Het afschaffen van internationale handel
    - De uitbreiding van de macht van een land door het verkrijgen van gebieden of invloed
    CorrectAnswer: 3
  - Question: Waar ging de Koude Oorlog voornamelijk over?
    Answers:
    - De VS en de Sovjetunie en hun respectieve blokken
    - Duitsland en Frankrijk
    - China en Japan
    CorrectAnswer: 1
